<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admission Alert</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #172033;
        }

        header {
            background: white;
            padding: 20px 40px;
            border-bottom: 1px solid #ddd;
        }

        h1 {
            margin: 0;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 20px;
        }

        .hero {
            background: linear-gradient(135deg, #171c4a, #3c35a8);
            color: white;
            padding: 45px;
            border-radius: 20px;
        }

        .hero h2 {
            font-size: 36px;
            margin-top: 0;
        }

        .sources {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-top: 25px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .dot {
            color: #16b957;
            font-size: 20px;
        }

        .alert {
            margin-top: 25px;
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        a {
            color: #4038c9;
            text-decoration: none;
            font-weight: bold;
        }

        @media (max-width: 800px) {
            .sources {
                grid-template-columns: 1fr;
            }

            .hero h2 {
                font-size: 28px;
            }

            .container {
                margin: 20px auto;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>🎓 Admission Alert</h1>
    <p>Never miss an important counselling update.</p>
</header>

<div class="container">

    <div class="hero">
        <h2>Admission Alert Dashboard</h2>

        <p>
            Track official admission and counselling notifications
            from KNRUHS, NTRUHS, MCC and TG EAPCET.
        </p>
    </div>

    <h2>Official Sources</h2>

    <div class="sources">

        {% for source in sources %}

        <div class="card">
            <span class="dot">●</span>

            <h3>{{ source.name }}</h3>

            <p>{{ source.full_name }}</p>

            <a href="{{ source.url }}" target="_blank">
                Official site →
            </a>
        </div>

        {% endfor %}

    </div>

    <h2>Important Updates</h2>

    {% for alert in alerts %}

    <div class="alert">

        <strong>{{ alert.priority }}</strong>

        <h2>{{ alert.title }}</h2>

        <p>{{ alert.summary }}</p>

        <p>
            📅 {{ alert.date }}
        </p>

        <a href="{{ alert.url }}" target="_blank">
            View official source →
        </a>

    </div>

    {% endfor %}

</div>

</body>
</html>
